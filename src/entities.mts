import { ARENA } from './content.mjs';
import type { ClassDefinition, Weapon, BossDefinition, Pattern, RaidState, ChargePath } from './types.mjs';
/** 플레이어 전투 상태 (시간: 초, 좌표: 전장 좌표) */
export class Player {
  x: number;
  y: number;
  weaponKey: string;
  hp: number;
  maxHp: number;
  comboStep: number;
  comboTime: number;
  timingPhase: number;
  counterTime: number;
  counterCooldown: number;
  guardTime: number;
  attackStep: number;
  attackChainTime: number;
  heat: number;
  attackHeld: boolean;
  comboPending: number;
  beamTime: number;
  wetStacks: number;
  wetTime: number;
  faceX: number;
  faceY: number;
  lastMoveX: number;
  lastMoveY: number;
  attackCooldown: number;
  charge: number;
  ammo: number;
  reloadTime: number;
  recoilTime: number;
  swing: { t: number;
    angle: number;
    hit: boolean;
    comboStep?: number;
    bonus?: number;
    beat?: number;
    shape?: string;
    reach?: number };
  dodgeTime: number;
  dodgeCooldown: number;
  dodgeX: number;
  dodgeY: number;
  dodgeChainTime: number;
  dodgeChainUsed: boolean;
  dodgeQueued: boolean;
  dodgeFromX: number;
  dodgeFromY: number;
  hurtFlash: number;
  shield: number;
  shieldTime: number;
  slowTime: number;
  heavyReady: boolean;
  heavyTime: number;
  dodgeBuffTime: number;
  hitCount: number;
  leechBudget: number;
  declare chargeFlash?: number;
  declare chargeShotPower?: number;
  declare attackBlocked?: boolean;
  declare moving?: boolean;
  declare guardX?: number;
  declare guardY?: number;
  declare primaryHits?: number;
  declare overheatTime?: number;
  constructor(cls: ClassDefinition, weapon: Weapon) {
    this.x = ARENA.width / 2;
    this.y = ARENA.height - 140;
    this.weaponKey = '';
    this.hp = cls.maxHp;
    this.maxHp = cls.maxHp;
    this.comboStep = 0;
    this.comboTime = 0;
    this.timingPhase = 0;
    this.counterTime = 0;
    this.counterCooldown = 0;
    this.guardTime = 0;
    this.attackStep = 0;
    this.attackChainTime = 0;
    this.heat = 0;
    this.attackHeld = false;
    this.comboPending = 0;
    this.beamTime = 0;
    this.wetStacks = 0;
    this.wetTime = 0;
    this.faceX = 0;
    this.faceY = -1;
    this.lastMoveX = 0;
    this.lastMoveY = -1;
    this.attackCooldown = 0;
    this.charge = 0;
    this.ammo = weapon.magazine || 0;
    this.reloadTime = 0;
    this.recoilTime = 0;
    this.swing = null;
    this.dodgeTime = 0;
    this.dodgeCooldown = 0;
    this.dodgeX = 0;
    this.dodgeY = 0;
    this.dodgeChainTime = 0;
    this.dodgeChainUsed = false;
    this.dodgeQueued = false;
    this.dodgeFromX = ARENA.width / 2;
    this.dodgeFromY = ARENA.height - 140;
    this.hurtFlash = 0;
    this.shield = 0;
    this.shieldTime = 0;
    this.slowTime = 0;
    this.heavyReady = false;
    this.heavyTime = 0;
    this.dodgeBuffTime = 0;
    this.hitCount = 0;
    this.leechBudget = 4;
  }
  /** Pause/end cancels active actions, preserving cooldowns already paid. */
  cancelActions(): void {
    this.charge = 0;
    this.swing = null;
    this.attackHeld = false;
    this.attackBlocked = true;
    this.comboPending = 0;
    this.comboStep = 0;
    this.beamTime = 0;
    this.guardTime = 0;
    this.counterTime = 0;
    this.attackCooldown = Math.max(0, this.attackCooldown);
  }
  /** Keep HP/card progression, reset combat timers and position for the next boss. */
  resetForStage(magazine: number): void {
    this.x=ARENA.width/2;
    this.y=ARENA.height-140;
    this.swing=null;
    this.attackCooldown=0;
    this.dodgeCooldown=0;
    this.dodgeTime=0;
    this.hurtFlash=0;
    this.shield=0;
    this.shieldTime=0;
    this.slowTime=0;
    this.heavyReady=false;
    this.heavyTime=0;
    this.dodgeBuffTime=0;
    this.hitCount=0;
    this.charge=0;
    this.reloadTime=0;
    this.recoilTime=0;
    this.ammo=magazine;
    this.leechBudget=4;
    this.dodgeChainTime=0;
    this.dodgeQueued=false;
    this.dodgeChainUsed=false;
    this.comboStep=0;
    this.comboTime=0;
    this.primaryHits=0;
    this.counterTime=0;
    this.guardTime=0;
    this.counterCooldown=0;
    this.attackStep=0;
    this.attackChainTime=0;
    this.heat=0;
    this.overheatTime=0;
    this.attackHeld=false;
    this.attackBlocked=false;
  }
}
/** 보스 정의와 현재 전투 상태 */
export class Boss {
  def: BossDefinition;
  x: number;
  y: number;
  hp: number;
  maxHp: number;
  faceX: number;
  faceY: number;
  state: string;
  timer: number;
  pattern: Pattern;
  hitFlash: number;
  phase: number;
  sequence: number;
  declare leap?: {fromX: number;
    fromY: number;
    x: number;
    y: number;
    windup: number};
  declare previousPattern?: string;
  declare slowTime?: number;
  declare wetTime?: number;
  declare wetCooldown?: number;
  declare wetStacks?: number;
  declare burnTime?: number;
  declare burnDps?: number;
  declare burnTick?: number;
  declare raid?: RaidState;
  declare combo?: { stages: Pattern[];
    index: number;
    total: number;
    pattern?: Pattern;
    next?: number };
  declare chargePaths?: ChargePath[];
  declare nextRaidAt?: number;
  declare normalCasts?: number;
  declare raidCount?: number;
  declare raid80?: boolean;
  declare raid40?: boolean;
  declare lastPattern?: string;
  declare patternIndex?: number;
  constructor(def: BossDefinition) {
    this.def = def;
    this.x = ARENA.width / 2;
    this.y = 200;
    this.hp = def.hp;
    this.maxHp = def.hp;
    this.faceX = 0;
    this.faceY = 1;
    this.state = 'idle';
    this.timer = def.idle;
    this.pattern = null;
    this.hitFlash = 0;
    this.phase = 1;
    this.sequence = 0;
  }
}
